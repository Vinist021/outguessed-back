# Exclusivamente local. Copie para .env somente se esse arquivo ainda não existir.
# APP_ENV do processo escolhe o modo; o valor deste arquivo não o altera.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080

# Deve coincidir com a porta publicada e as credenciais de compose.yaml.
# Neste computador, altere POSTGRES_PORT e a porta de DATABASE_URL para 5434.
POSTGRES_PORT=5432
DATABASE_URL=postgres://outguessed:outguessed_local@127.0.0.1:5432/outguessed?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081
LOG_LEVEL=info
STARTUP_TIMEOUT=10s
DEPENDENCY_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
